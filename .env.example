# --- Core ---
ENV=dev
DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5443/voice
REDIS_URL=redis://localhost:6390/0
INTERNAL_API_TOKEN=
WORKSPACE_COOKIE_SECRET=
APP_ORIGIN=http://localhost:5173

# --- User auth ---
AUTH_JWT_SECRET=                  # >=16 chars, e.g. `openssl rand -hex 32`; different from WORKSPACE_COOKIE_SECRET
ACCESS_TOKEN_TTL_SECONDS=604800
# Google sign-in (optional; the button is disabled while these are empty).
# Console: APIs & Services > Credentials > OAuth client (Web). Authorised redirect URI must equal GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=              # default: ${APP_ORIGIN}/api/v1/auth/google/callback
UPLOAD_DIR=uploads                # profile pictures

# --- LiveKit Cloud ---
LIVEKIT_URL="wss://YOUR-PROJECT.livekit.cloud"
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
AGENT_NAME=voice-agent
ENABLE_NOISE_CANCELLATION=true   # LiveKit Cloud only; set false when self-hosting

# --- Gemini (LLM, context-prompt generation, summaries). Read by livekit-plugins-google as GOOGLE_API_KEY ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash
AGENT_LLM_MODEL=gemini-3.5-flash-lite
AGENT_LLM_FALLBACK_MODELS=        # empty = flash-lite only (fastest); e.g. gemini-3.8-flash,gemini-3.5-flash to fail over on overload

# --- Deepgram (STT + TTS). Env var read by livekit-plugins-deepgram ---
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
STT_PROVIDER=deepgram
TTS_PROVIDER=deepgram
STT_MODEL=nova-3
TTS_MODEL=aura-2-draco-en

# --- Agent -> backend ---
# local dev: localhost. docker compose overrides this to http://backend:8000
BACKEND_INTERNAL_URL=http://localhost:8000
LATENCY_PROFILE=balanced

# --- Phone calls: Twilio Elastic SIP trunk -> LiveKit outbound trunk ---
# Phone calls stay switched off until SIP_OUTBOUND_TRUNK_ID is set. Create everything with
#   cd backend && uv run python -m app.scripts.setup_phone_calls --country IN
# (needs an upgraded Twilio account and a voice number on it), then set the ID it prints.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164, e.g. +15551234567: the caller ID borrowers see
SIP_TRUNK_DOMAIN=               # optional, default alex-voice-<account>.pstn.twilio.com
SIP_AUTH_USERNAME=              # optional, default alex_livekit
SIP_AUTH_PASSWORD=              # optional, generated by the setup script when empty
SIP_OUTBOUND_TRUNK_ID=          # ST_..., printed by the setup script (backend)
SIP_RINGING_TIMEOUT_SECONDS=40  # how long a borrower's phone rings before it counts as no answer

# --- Feature flags / retention ---
FEATURE_OUTBOUND_PANEL=false
TRANSCRIPT_RETENTION_DAYS=90
SUMMARY_WEBHOOK_URL=
SUMMARY_WEBHOOK_SECRET=
