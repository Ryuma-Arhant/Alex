server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # The internal API (agent <-> backend) is never reachable through the public proxy.
  location /internal { return 404; }

  # The backend is looked up through the container's own DNS on every request (cached 10 s), so a redeployed
  # backend with a new private address is picked up without restarting nginx.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  location /api/ {
    set $backend ${BACKEND_UPSTREAM};
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location /metrics { return 404; }

  location / { try_files $uri /index.html; }
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
}
